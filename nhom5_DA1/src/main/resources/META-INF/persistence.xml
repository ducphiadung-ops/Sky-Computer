<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="nhom5PU" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Liệt kê toàn bộ entity class -->
        <class>demo.entity.hoa_don.HoaDon</class>
        <class>demo.entity.hoa_don.ChiTietHoaDon</class>
        <class>demo.entity.hoa_don.HinhThucThanhToan</class>
        <class>demo.entity.hoa_don.LichSuHoaDon</class>
        <class>demo.entity.hoa_don.LichSuThanhToan</class>
        <class>demo.entity.khach_hang.KhachHang</class>
        <class>demo.entity.khach_hang.DiaChiKhachHang</class>
        <class>demo.entity.khach_hang.DiaChiApiMapping</class>
        <class>demo.entity.nhan_vien.NhanVien</class>
        <class>demo.entity.san_pham.SanPham</class>
        <class>demo.entity.san_pham.CauHinhSanPham</class>
        <class>demo.entity.san_pham.ChiTietSanPham</class>
        <class>demo.entity.san_pham.ChiTietPhieuNhap</class>
        <class>demo.entity.san_pham.Cpu</class>
        <class>demo.entity.san_pham.DanhMuc</class>
        <class>demo.entity.san_pham.Gpu</class>
        <class>demo.entity.san_pham.HinhAnhSanPham</class>
        <class>demo.entity.san_pham.ManHinh</class>
        <class>demo.entity.san_pham.MaSeri</class>
        <class>demo.entity.san_pham.MauSac</class>
        <class>demo.entity.san_pham.NhaCungCap</class>
        <class>demo.entity.san_pham.OCung</class>
        <class>demo.entity.san_pham.PhieuNhap</class>
        <class>demo.entity.san_pham.Pin</class>
        <class>demo.entity.san_pham.Ram</class>
        <class>demo.entity.san_pham.ThuongHieu</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:sqlserver://localhost:1433;databaseName=DB_Quan_ly_may_tinh;encrypt=true;trustServerCertificate=true;"/>
            <property name="jakarta.persistence.jdbc.user"     value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value="123456"/>
            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.SQLServer2016Dialect"/>
            <property name="hibernate.show_sql"   value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>

    </persistence-unit>
</persistence>
